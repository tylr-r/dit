                  text (path == "beginner" ? "Start from the basics and build up." : "Quick tour, then dive right in.") font-size="0.824rem" line-height=1.43 color="dit-ink-muted" text-align="left"
            column height=48 flex-shrink=0 aria-hidden=true
          else if nativeLessonPreview or nativeReminder
