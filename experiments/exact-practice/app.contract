                  text (qsoPhase == "rx-ready" ? "Transmission complete" : qsoPhase == "receiving" ? "Listening…" : qsoPhase == "paused" ? "Paused" : qsoPhase == "ended" ? "QSO ended" : qsoPhase == "sending" ? "Waiting for the other station…" : "") testId="qso-phase" role="status" min-height=24 font-size="0.941rem" text-align="center"
