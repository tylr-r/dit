              text "Check your sound" role="heading" aria-level=1 testId="nux-step" font-size="1.647rem" font-weight=600 letter-spacing="-0.6px" text-align="center"
              text (outputVolumeLow ? "Your volume looks low. Raise it with the side buttons, then test the sound." : "Tap below to confirm you can hear the tones.") role="status" font-size="0.882rem" line-height=1.47 text-align="center" color="dit-ink-secondary"
            column flex=1 align-items="center" justify-content="center" gap=24 padding-top=24
