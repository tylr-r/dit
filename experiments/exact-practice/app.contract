              row width="100%" padding=3 gap=0 border-radius=10 background-color="#0b0e12" box-sizing="border-box" margin-bottom=12
                for method in ["course","open"] key=method
                  button (method == "course" ? "Course" : "Open practice") press=switchLearningMethod(method) aria-label=(method == "course" ? "Course mode" : "Open practice mode") id=(method == "course" ? "native-course-tab" : "native-open-tab") testId=("learning-" + method) aria-pressed=(learningMethod == method) flex=1 min-width=0 min-height=36 box-sizing="border-box" appearance="none" border-width=0 border-radius=8 padding="4px 8px" font-size="0.765rem" background-color=(learningMethod == method ? "rgba(255,255,255,0.12)" : "transparent") color=(learningMethod == method ? "dit-ink" : "dit-ink-secondary")
              column width="100%" min-height=0 max-height=(learningMethod == "course" ? "59dvh" : "55dvh") overflow="auto" border-radius=14 background-color="#0b0e12" testId="learning-body"
