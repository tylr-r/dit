                else
                  image "symbol:sf/speaker.wave.2.fill" width=36 height=36 aria-hidden=true
                text (nuxSound == "heard" ? "Sound works" : "Test sound") font-size=(nuxSound == "heard" ? "0.941rem" : "1rem") font-weight=600 text-align="center"
              if outputVolumeLow and nuxSound != "heard"
                column align-items="center" gap=8
                  text "Try this" font-size="0.824rem" font-weight=600
                  text "Raise the volume with the side buttons." font-size="0.824rem" text-align="center" color="dit-ink-muted"
                  text "Check Silent Mode in Control Center if you still hear nothing." font-size="0.824rem" text-align="center" color="dit-ink-muted"
              if nuxSound == "failed"
                text "Check your audio output and test the sound again." role="status" text-align="center"
            button "Continue" press=nux("continue") disabled=(nuxSound != "heard") testId="nux-continue" backgroundMaterial="glass" glassInteractive=true width="100%" box-sizing="border-box" min-height=48 padding="12px 24px" border-radius=30 font-size="0.941rem" font-weight=600 color="dit-ink"
          else
            column flex=1 width="100%" align-items="center" justify-content="center" gap=24 padding-top=32 box-sizing="border-box"
              dit-intro-artwork slide=nuxStep reduce-motion=media.prefersReducedMotion aria-hidden=true pointer-events="none" width="100%" height=(media.height < 700 ? 150 : 230) flex-shrink=0 testId="intro-artwork"
              column gap=12 min-height=180 max-width=480 align-items="center"
                text (nuxStep == "intro_fluency" ? "Real Morse fluency." : nuxStep == "intro_listen" ? "No chart. Just listen." : "Real speed from day one.") testId="nux-step" role="heading" aria-level=1 text-align="center" font-size="1.647rem" font-weight=600 letter-spacing="-0.6px"
                text (nuxStep == "intro_fluency" ? "Science-backed training, instant feedback, and smart review that targets your weakest letters." : nuxStep == "intro_listen" ? "Experienced operators don't count dots and dashes. They hear each letter the way you hear your name. Dit trains that reflex from the start." : "Slow letters teach you to count. Dit uses the Koch method, which keeps every character at a usable speed. The gaps between letters start roomy and tighten as you improve, so you always have time to think.") font-size="0.882rem" line-height=1.47 color="dit-ink-secondary" text-align="center"
            button "Continue" press=nux("continue") testId="nux-continue" backgroundMaterial="glass" glassInteractive=true width="100%" box-sizing="border-box" min-height=48 padding="12px 24px" border-radius=30 font-size="0.941rem" font-weight=600 color="dit-ink"
      dialog id="entry-account" aria-label="Sign in to Dit" closedby="any" cancel=closeEntryAccount width="100%" box-sizing="border-box" color-scheme="dark"
        if panel == "entry-account"
          column gap=8 padding=16 width="100%" box-sizing="border-box" align-items="center" background-color="dit-panel" color="dit-ink" border-radius=20
            if emailForm
              row width="100%" align-items="center" justify-content="space-between"
                button "‹" aria-label="Back to sign-in options" press=emailBack appearance="none" width=44 min-height=44 padding=0 color="dit-ink" font-size="1.45rem" background-color="transparent" border-width=0
                text "Email sign-in" role="heading" aria-level=2 font-size="0.824rem" font-weight=500
                column aria-hidden=true width=44
              input id="dit-email-address" type="email" aria-label="Email" placeholder="Email" value=emailAddress input=editEmailAddress disabled=(emailBusy != "") autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck=false enterkeyhint="next" class=EmailField
              input id="dit-email-password" hatch="dit-email-password" type="password" aria-label="Password" placeholder="Password" value=emailPassword input=editEmailPassword submit=submitEmail("email-signin") disabled=(emailBusy != "") autocomplete="current-password" autocorrect="off" spellcheck=false enterkeyhint="go" class=EmailField
              if emailError != ""
                text emailError role="alert" color="#ff9696" width="100%" font-size="0.765rem"
              button press=submitEmail("email-signin") disabled=(not canSubmitEmail) aria-label="Sign in with email" aria-busy=(emailBusy == "email-signin") appearance="none" width="100%" min-height=46 background-color="rgba(255,255,255,0.12)" border-width=0 border-radius=14 color="dit-ink" opacity=(canSubmitEmail ? 1 : 0.45)
                if emailBusy == "email-signin"
                  progress aria-label="Signing in" width=22 height=18
                else
                  text "Sign in"
              button press=submitEmail("email-signup") disabled=(not canSubmitEmail) aria-label="Create account with email" aria-busy=(emailBusy == "email-signup") appearance="none" width="100%" min-height=44 background-color="transparent" border-width=0 color="dit-ink-secondary"
                if emailBusy == "email-signup"
                  progress aria-label="Creating account" width=22 height=18
                else
                  text "Create account"
            else
              text "Sign in to Dit" role="heading" aria-level=2 font-size="0.824rem" font-weight=500
              if fixtureAccounts
                text "Isolated Simulator accounts" role="status" font-size="0.824rem" color="dit-ink-secondary"
                for learner in ["A","B"] key=learner
                  if fixtureLearners.includes(learner)
                    button ("Fixture learner " + learner) press=chooseFixtureAccount(learner) disabled=(pendingProvider != "") class=SheetControl min-height=44 width="100%" border-radius=14
              else
                text "Account sign-in is unavailable in this offline build." role="status" text-align="center" font-size="0.824rem" color="dit-ink-secondary"
              button press=startProviderSignIn("apple") disabled=(not fixtureAccounts or not appleFixtureAvailable or pendingProvider != "") aria-label="Continue with Apple" class=SheetControl width="100%" border-radius=14
                row justify-content="center" align-items="center" gap=8
                  if appleSession
                    image "symbol:sf/applelogo" width=18 height=18 aria-hidden=true
                  text "Continue with Apple"
              button press=startProviderSignIn("google") disabled=(not fixtureAccounts or not googleFixtureAvailable or pendingProvider != "") aria-label="Continue with Google" class=SheetControl width="100%" border-radius=14
                row justify-content="center" align-items="center" gap=8
                  if appleSession
                    image "assets/google-provider.png" width=18 height=18 aria-hidden=true
                  text "Continue with Google"
              button "Continue with Email" press=showEmailForm disabled=(pendingProvider != "") class=SheetControl width="100%" border-radius=14
              button "Cancel" aria-label="Cancel sign-in" press=closeEntryAccount class=SheetControl min-height=44 width="100%" border-radius=14
      dialog id="phase-gate" aria-label=gateTitle closedby="closerequest" cancel=acceptPracticeGate width="100%" height="100%" max-width="none" max-height="none" margin=0 padding=0 background-color="transparent" border-width=0 box-sizing="border-box" color="dit-ink"
        ::backdrop
          background-color="dit-scrim"
        if nativePhaseDialog
          column width="100%" min-height="100%" position="relative" align-items="center" justify-content="center" padding="0 24px" box-sizing="border-box"
            button press=acceptPracticeGate aria-label="Close dialog" aria-description="Dismisses this dialog" testId="guided-native-backdrop" appearance="none" position="absolute" inset=0 width="100%" height="100%" border-width=0 padding=0 background-color="transparent"
            column position="relative" z-index=1 width="100%" max-width=360 align-items="center" gap=12 padding=24 box-sizing="border-box" background-color="dit-panel" border="1px solid var(--dit-border)" border-radius=18 opacity=(gateExiting ? 0 : 1) scale=(gateExiting ? 0.96 : 1) transition=(media.prefersReducedMotion ? "none" : "opacity 140ms cubic-bezier(0.23,1,0.32,1), scale 140ms cubic-bezier(0.23,1,0.32,1)")
              text gateTitle role="heading" aria-level=2 font-size="1.059rem" font-weight=600 letter-spacing=0.4 text-align="center"
              if gateSubtitle != ""
                text gateSubtitle font-size="0.824rem" line-height=1.43 color="dit-ink-secondary" text-align="center"
              if not guideCelebrate and guidePhase != "gate-retry"
                row testId="gate-letters" justify-content="center" flex-wrap="wrap" gap=8 margin="4px 0"
                  for letter in guidePack.split(",") key=letter
                    column width=72 min-height=72 justify-content="center" align-items="center" border-radius=18 background-color="dit-input" border="1px solid var(--dit-border)"
                      text letter font-size="1.529rem" font-weight=700
              if guideCelebrate and guideStorage != "saved"
                text "Course completion may not be saved on this device." role="status" font-size="0.824rem" color="dit-ink-secondary" text-align="center"
              button press=acceptPracticeGate aria-label="Continue" testId="guided-native-continue" appearance="none" border-width=0 background-color="transparent" min-height=44 padding=0 display="flex" align-items="center" justify-content="center"
                column backgroundMaterial="glass" padding="10px 24px" border-radius=14 pointer-events="none"
                  text "CONTINUE" letter-spacing=1.1 font-size="0.706rem" color="dit-ink-secondary"
      dialog id="course-complete" testId="guided-complete-dialog" aria-label="Course complete" closedby="any" cancel=dismissCourseComplete background-color="#14212b" color="#faf7f5" border-radius=28 padding=24 width="100%" max-width="24rem" box-sizing="border-box"
        column gap=12
          text "Course complete" role="heading" aria-level=2 font-size="1.25rem"
