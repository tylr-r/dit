          button "Done" press=dismissCourseComplete testId="guided-complete-dismiss" min-height=44
      dialog id="about" aria-label="About Dit" closedby="any" cancel=closePanel background-color="dit-panel" color="dit-ink" border="1px solid var(--dit-border)" border-radius=16 width="calc(100% - 48px)" max-width=360 padding=20 box-sizing="border-box" max-height="85vh" overflow="auto"
        if panel == "about"
          column gap=12 align-items="flex-start"
            text "DIT" role="heading" aria-level=2 font-size="1.294rem" letter-spacing=2
