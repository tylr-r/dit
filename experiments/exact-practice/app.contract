              row align-items="center" justify-content="center" gap=8 flex-wrap="wrap"
                button "Send first" press=conversationCommand("send-first") testId="qso-send-first" class=NativeContactChoice glassInteractive=true
                button "Receive first" press=conversationCommand("receive-first") testId="qso-receive-first" class=NativeContactChoice glassInteractive=true
