              text (nativeReminder ? "Pick a time and we'll remind you to practice. Change or turn it off anytime in Settings." : nuxStep == "beginner_stages" ? "Each pack moves through three stages." : "You'll start with two letters and build from there.") font-size="0.882rem" line-height=1.47 text-align="center" color="dit-ink-secondary"
