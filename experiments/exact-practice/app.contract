                  text nuxReminderLabel aria-hidden=true font-size="0.765rem" letter-spacing="0.8px" font-weight=600 color="dit-ink-muted"
                  dit-reminder-wheel clock-time=nuxReminderTime wheel-disabled=(reminderBusy or reminderExiting) message=reminderWheel width="100%" height=216 testId="nux-reminder-time"
                button "Not now" aria-label="Skip reminder" press=nux("reminder-skip") testId="nux-reminder-skip" min-height=44 box-sizing="border-box" padding="8px 12px" appearance="none" background-color="transparent" border="none" font-size="0.882rem" color="dit-ink-muted"
                if reminderError != ""
                  text reminderError role="status"
            if nativeReminder
              button "Turn on reminder" press=nux("reminder-enable") disabled=reminderBusy testId="nux-reminder-enable" backgroundMaterial="glass" glassInteractive=true width="100%" box-sizing="border-box" min-height=48 padding="12px 24px" border-radius=30 font-size="0.941rem" font-weight=600 color="dit-ink"
            else
              button (nuxStep == "beginner_intro" ? "Start first lesson" : "Continue") press=nux("continue") testId="nux-continue" backgroundMaterial="glass" glassInteractive=true width="100%" box-sizing="border-box" min-height=48 padding="12px 24px" border-radius=30 font-size="0.941rem" font-weight=600 color="dit-ink"
          else if nativeTutorial
            column align-items="center" gap=12 padding-top=32
              text "Meet the Morse key" role="heading" aria-level=1 testId="nux-step" font-size="1.647rem" font-weight=600 letter-spacing="-0.6px" text-align="center"
              text "Try it on the key below — short taps are dits, long holds are dahs." font-size="0.882rem" line-height=1.47 text-align="center" color="dit-ink-secondary"
            column flex=1 align-items="center" justify-content="center" gap=16 padding-top=24
              text (nuxTaps == "3" ? "Now hold 3 times" : "Tap 3 times on the key") role="status" testId="tutorial-instruction" font-size="1.176rem" font-weight=600 text-align="center"
              for kind in ["Tap","Hold"] key=kind
                row min-width=120 align-items="center" justify-content="space-between" gap=12 role="img" aria-label=(kind == "Tap" ? "Taps " + nuxTaps + " of 3" : "Holds " + nuxHolds + " of 3") testId=(kind == "Tap" ? "nux-taps" : "nux-holds")
                  text (kind == "Tap" ? "TAP (DIT)" : "HOLD (DAH)") aria-hidden=true font-size="0.765rem" letter-spacing="0.8px" color="dit-ink-muted"
                  row gap=5 aria-hidden=true
                    for pip in ["1","2","3"] key=pip
                      column width=8 height=8 border-radius=4 border="1px solid rgba(250,247,245,0.32)" background-color=((kind == "Tap" ? nuxTaps : nuxHolds) >= pip ? "#71deb0" : "transparent")
              row align-items="center" justify-content="space-between" min-width=180 min-height=44 padding="8px 12px" box-sizing="border-box" gap=16 border-radius=32 background-color="rgba(255,255,255,0.06)" border="1px solid var(--dit-border)"
                text "HAPTICS" aria-hidden=true font-size="0.765rem" letter-spacing="0.8px" font-weight=600 color="dit-ink-muted"
                input type="checkbox" switch checked=hapticsEnabled change=setHaptics aria-label="Haptics" testId="tutorial-haptics" accent-color="#ff954d"
              if not hapticsSaved
