            button "Stay signed out" press=nux("start") testId="nux-start" appearance="none" border-width=0 background-color="transparent" box-sizing="border-box" min-height=44 padding="6px 12px" font-size="0.765rem" letter-spacing="0.2px" color="rgba(200,210,220,0.5)"
