            column align-items="center" max-width=360 gap=12 padding-bottom="calc(env(safe-area-inset-bottom) + 20px)"
              text (qsoPhase == "ended" ? "QSO ended" : qsoPhase == "error" ? "Station unavailable" : "Connecting…") testId="qso-phase" role="status" font-size="1.647rem" font-weight=600 text-align="center"
