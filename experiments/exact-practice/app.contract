                    button "Replay" press=conversationCommand("replay") testId="qso-replay" class=NativeContactChoice
                  textarea testId="qso-copy" aria-label="Type what you hear" placeholder="Type what you hear (optional)" autocorrect="off" autocapitalize="characters" spellcheck=false value=qsoCopy input=editQsoCopy rows=3 maxlength=2000 class=PassageField min-height=84 font-size="0.941rem"
                  row justify-content="center" align-items="center" gap=8
