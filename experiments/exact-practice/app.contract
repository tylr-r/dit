                button "Clear" press=conversationCommand("clear") testId="qso-clear" min-height=44 color="dit-ink" background-color="#172633"
                button "Send" press=conversationCommand("send") testId="qso-send" disabled=(qsoDraft == "") min-height=44 color="dit-ink" background-color="#172633"
              if qsoPhase == "rx-ready"
                button "Reveal" press=conversationCommand("reveal") testId="qso-reveal" min-height=44 color="dit-ink" background-color="#172633"
                button "Check copy" press=conversationCommand("check") testId="qso-check" min-height=44 color="dit-ink" background-color="#172633"
                button "Start my turn" press=conversationCommand("start-turn") testId="qso-start-turn" min-height=44 color="dit-ink" background-color="#172633"
              if qsoPhase == "receiving"
                button "Pause" press=conversationCommand("pause") testId="qso-pause" min-height=44 color="dit-ink" background-color="#172633"
              if qsoPhase == "paused"
                button "Resume" press=conversationCommand("resume") testId="qso-resume" min-height=44 color="dit-ink" background-color="#172633"
              if qsoReplayable and (qsoCopying or (qsoPhase == "tx" and qsoDraft == ""))
                button "Replay" press=conversationCommand("replay") testId="qso-replay" min-height=44 color="dit-ink" background-color="#172633"
              if qsoPhase == "error"
                button "Retry" press=conversationCommand("retry") testId="qso-retry" min-height=44 color="dit-ink" background-color="#172633"
              if qsoPhase != "idle" and qsoPhase != "ended" and qsoPhase != "consent"
                button "End QSO" press=conversationCommand("end") testId="qso-end" min-height=44 color="dit-ink" background-color="#172633"
              if qsoPhase == "ended"
                button "New QSO" press=conversationCommand("new") testId="qso-new" min-height=44 color="dit-ink" background-color="#172633"
