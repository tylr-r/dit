test "options closes without changing target in a singleton scope"
  tap "Settings"
  tap "scope-open"
  tap "scope-custom"
  tap "scope-letter-Q"
  tap "scope-apply"
  tap "Settings"
  tap "close-panel"
  expect text "target" == "Q"

test "Freestyle Clear resets press state"
  tap "mode-freestyle"
  tap "clear"
  expect state pressing == false

test "mode returns to the selected Practice target"
  tap "Settings"
  tap "scope-open"
  tap "scope-custom"
  tap "scope-letter-Q"
  tap "scope-apply"
  tap "mode-freestyle"
  tap "mode-practice"
  expect text "target" == "Q"

test "Listen initially does not reveal a target"
  tap "mode-listen"
  expect state listenReveal == ""

test "guided lesson starts with a visible Teach target"
  tap "Settings"
  tap "guided-start"
  expect text "guided-phase" == "Teach"
  expect text "target" == "E"

test "Words starts ready with no answer content"
  tap "mode-listen"
  tap "listen-words"
  expect state wordPhase == "ready"
  expect state wordOptions == ""

test "Custom starts in local passage editor"
  tap "mode-listen"
  tap "listen-custom"
  expect state customPhase == "editor"
  expect state customCopy == ""

test "Conversation enters silently without received content"
  tap "mode-conversation"
  expect state qsoPhase == "idle"
  expect state qsoRxText == ""
  expect state qsoCopy == ""

test "Conversation route leaves the selected desk mode independent"
  tap "mode-freestyle"
  tap "mode-conversation"
  expect state selectedMode == "freestyle"
  expect state qsoPhase == "idle"

test "Course sheet stays open to choose a pack"
  tap "Settings"
  tap "scope-open"
  tap "learning-course"
  expect state learningMethod == "course"
  expect enabled "course-pack-14"

test "Back from custom keeps changes in the draft only"
  tap "Settings"
  tap "scope-open"
  tap "scope-custom"
  tap "scope-letter-Z"
  tap "scope-back"
  expect enabled "scope-tier-1"
  expect state scopeDraft == ""
