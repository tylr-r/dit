{
  "name": "dit",
  "private": true,
  "version": "2026.5.31",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "sim": "pnpm --filter @dit/ios ios",
    "device": "pnpm --filter @dit/ios ios --device",
    "preview": "turbo run preview",
    "deploy": "pnpm --filter @dit/web build && firebase deploy",
    "security:history": "node ./scripts/check-private-history.js",
    "test:unit": "turbo run test:unit",
    "test:unit:run": "turbo run test:unit:run",
    "test:types": "turbo run test:types",
    "test:e2e": "turbo run test:e2e",
    "test:security": "node --test scripts/tests/dependency-security.test.mjs"
  },
  "devDependencies": {
    "turbo": "^2.9.16"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@>=7 <7.29.6": "^7.29.7",
      "@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "@grpc/grpc-js@<1.13.6": "^1.13.6",
      "@tootallnate/once": "2.0.1",
      "@xmldom/xmldom@<0.8.15": "^0.8.15",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "brace-expansion@<2": "^1.1.21",
      "brace-expansion@>=5 <5.0.12": "^5.0.12",
      "browserslist@<4.28.7": "^4.28.7",
      "compression@<1.8.2": "^1.8.2",
      "expo@>=58 <58.0.22": "~58.0.22",
      "glob@>=13 <14": "14.0.3",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "minimatch@>=10 <11": "11.0.3",
      "nanoid@>=3 <3.3.18": "^3.3.18",
      "node-forge@<1.4.2": "^1.4.2",
      "postcss": "^8.5.23",
      "protobufjs": "^7.6.5",
      "shell-quote@<1.9.0": "^1.9.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "undici": "^6.24.0",
      "websocket-driver@<0.7.5": "^0.7.5",
      "ws@>=7 <7.5.11": "^7.5.11",
      "ws@>=8 <8.21.0": "^8.21.0",
      "zod@>=4 <4.6.6": "^4.6.6"
    },
    "patchedDependencies": {
      "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch"
    },
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@shopify/react-native-skia",
      "esbuild",
      "protobufjs",
      "sharp"
    ]
